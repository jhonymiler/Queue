{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/validate-pr-template.sh",
        "matcher": "gh\\s+pr\\s+create",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/validate-pr-tooluse.sh",
        "matcher": "gh\\s+pr\\s+create",
        "timeout": 10
      }
    ]
  }
}
