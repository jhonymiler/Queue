{
  "version": 1,
  "targets": {
    "cursor": {
      "enabled": true,
      "rules_dir": ".cursor/rules",
      "rules_ext": ".mdc",
      "hooks_dir": ".cursor/hooks",
      "hooks_config": ".cursor/hooks.json",
      "skills_dir": ".cursor/skills"
    },
    "claude-code": {
      "enabled": false,
      "rules_file": "CLAUDE.md",
      "hooks_config": ".claude/settings.json",
      "skills_dir": ".claude/skills"
    },
    "copilot": {
      "enabled": false,
      "rules_file": ".github/copilot-instructions.md",
      "instructions_dir": ".github/instructions"
    },
    "codex": {
      "enabled": false,
      "rules_file": "AGENTS.md",
      "agents_dir": ".codex/agents"
    },
    "kiro": {
      "enabled": false,
      "steering_dir": ".kiro/steering",
      "hooks_dir": ".kiro/hooks",
      "skills_dir": ".kiro/skills"
    }
  },
  "hooks": {
    "beforeShellExecution": {
      "script": "validate-pr-template.sh",
      "matcher": "gh\\s+pr\\s+create",
      "failClosed": true,
      "timeout": 10
    },
    "preToolUse": {
      "script": "validate-pr-tooluse.sh",
      "matcher": "Shell",
      "timeout": 10
    },
    "beforeSubmitPrompt": {
      "type": "prompt",
      "prompt": "Analise o prompt do usuario. Se ele menciona criar PR, abrir PR, pull request, merge request, ou pedir review de codigo para merge, injete o seguinte contexto: 'LEMBRETE: Este projeto exige que todo PR siga o template obrigatorio com 5 secoes: Contexto, Objetivo, Criterios de Aceite, Como Testar Manualmente e Cenarios de Teste. Leia a skill pr-reviewer antes de prosseguir.' Se o prompt NAO e sobre criacao de PR, ignore.",
      "timeout": 10
    }
  },
  "required_sections": [
    "Contexto",
    "Objetivo",
    "Critérios de Aceite",
    "Como Testar Manualmente",
    "Cenários de Teste"
  ]
}